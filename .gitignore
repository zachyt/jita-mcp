# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# uv
# (.python-version is intentionally committed so contributors get the same Python)

# Build / dist
build/
dist/
*.egg-info/
*.egg
wheels/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
htmlcov/
.coverage
.coverage.*

# Editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
._*
Thumbs.db
Desktop.ini

# Environment
.env
.env.local
.env.*.local
.envrc

# Logs / runtime state
*.log
*.pid

# Backup / merge debris
*.bak
*.orig
*.tmp

# Coverage formats beyond htmlcov
coverage.xml
*.cover

# Defensive: keep stray lockfiles from other Python tools from sneaking in
Pipfile.lock
poetry.lock
pdm.lock

# Defensive: in case JS tooling lands (mcp-inspector via npx, etc.)
node_modules/

# Docker local overrides
docker-compose.override.yml
compose.override.yaml

# Data — never commit the full SDE (~700MB) or pyfa-built eve.db (~94MB)
data/
vendor/pyfa/eve.db
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.bz2

# Allow tiny test fixtures
!tests/fixtures/
!tests/fixtures/*.sqlite

# Local runtime state
price_cache.sqlite
