# Build artifacts and caches — recreated inside the image
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/

# Local data — re-fetched inside the SDE stage
data/

# Editor / OS junk
.idea/
.vscode/
.DS_Store

# Local env files — runtime env comes from the deploy platform
.env
.env.local
.env.*.local

# Tests — not needed in the production image
tests/

# Docs / meta — kept tiny things that pyproject references; runtime
# stage doesn't COPY them so they never reach the final image.
LICENSE
jita_mcp_handoff.md
.pre-commit-config.yaml
.gitignore
.gitmodules
.python-version

# Pyfa: send only the bits we need (eos source, db_update.py, staticdata,
# and the root utils/ package — eos.utils.cycles does `from utils.repr
# import makeReprStr` against pyfa's top-level utils). Skip the ~250MB of
# GUI assets.
vendor/pyfa/**
!vendor/pyfa/eos/**
!vendor/pyfa/utils/**
!vendor/pyfa/staticdata/**
!vendor/pyfa/db_update.py
# Skip eve.db itself if a dev has built it locally; the pyfa stage builds
# a fresh one from staticdata.
vendor/pyfa/eve.db

# Git internals
.git/
.github/
