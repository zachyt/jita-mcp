# Copy to .env for local dev. All vars are optional — defaults in jita_mcp/config.py.

# Path to the Fuzzwork SQLite SDE (run scripts/fetch_sde.py to populate).
# Used by Fuzzwork-backed tools; ship/module/dogma data goes through pyfa's eve.db.
JITA_MCP_SDE_PATH=data/sde.sqlite

# Bind address for the MCP server
JITA_MCP_HOST=0.0.0.0
JITA_MCP_PORT=8080
