# Copy to .env for local dev. All vars are optional — defaults in jita_mcp/config.py.

# Path to the SQLite SDE (run scripts/fetch_sde.py to populate)
JITA_MCP_SDE_PATH=data/sde.sqlite

# Path to the ESI price cache (created automatically)
JITA_MCP_PRICE_CACHE_PATH=data/price_cache.sqlite

# How long a cached price is considered fresh (seconds)
JITA_MCP_PRICE_CACHE_TTL_SECONDS=1800

# ESI base URL and region ID for market lookups (default: The Forge / Jita)
JITA_MCP_ESI_BASE_URL=https://esi.evetech.net/latest
JITA_MCP_ESI_MARKET_REGION_ID=10000002

# Bind address for the MCP server
JITA_MCP_HOST=0.0.0.0
JITA_MCP_PORT=8080
